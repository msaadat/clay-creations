# Copy to .env and fill in real values.

# SQLite database file. In Docker this should point at the mounted volume,
# e.g. file:/data/prod.db
DATABASE_URL="file:./dev.db"

# Signs the admin session cookie. Must be 32+ characters.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# WhatsApp number that receives order confirmations.
# International format, digits only — no +, spaces or dashes.
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"

# Seed-time admin credentials (only read by `npm run db:seed`).
ADMIN_EMAIL="admin@claycreations.pk"
ADMIN_PASSWORD="changeme123"
