// ClayCreations storefront schema.
//
// Two conventions worth knowing before you edit this file:
//   1. All money is stored as INTEGER paisa (Rs. 1,550.00 -> 155000). SQLite has no
//      decimal type, and integer math avoids rounding drift on order totals.
//   2. SQLite has no native enums, so `Order.status` is a plain string. The allowed
//      values live in src/lib/orders.ts and are enforced by Zod, not the database.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts for CLI/migrate, and the
// PrismaClient gets a driver adapter at runtime (see src/lib/db.ts).
datasource db {
  provider = "sqlite"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  products    Product[]

  @@index([sortOrder])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  isActive    Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  images      ProductImage[]
  variants    Variant[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

/// Every product has at least one Variant, even when it has no options to pick.
/// Single-variant products get one row with `optionName = null`, which keeps the
/// cart, stock checks and order lines on a single code path.
model Variant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionName  String?
  optionValue String?
  pricePaisa  Int
  stock       Int         @default(0)
  sku         String?     @unique
  sortOrder   Int         @default(0)
  orderItems  OrderItem[]

  @@index([productId, sortOrder])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  customerPhone String
  customerEmail String?
  addressLine   String
  city          String
  postalCode    String?
  notes         String?
  subtotalPaisa Int
  shippingPaisa Int         @default(0)
  totalPaisa    Int
  status        String      @default("PENDING_PAYMENT")
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
}

/// Order lines snapshot the product name, variant label and price at purchase
/// time, so editing or deleting a product never rewrites historical orders.
model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName    String
  variantLabel   String?
  productSlug    String
  imageUrl       String?
  unitPricePaisa Int
  quantity       Int
  lineTotalPaisa Int

  @@index([orderId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
